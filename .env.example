# ============================================================
#  Radar Tributar IA — Plantilla de variables de entorno
# ============================================================
# Este archivo es SOLO una PLANTILLA (no lleva valores reales).
# - En LOCAL: cópialo a `.env.local` y completa lo que necesites.
# - En PRODUCCIÓN: los valores REALES viven en Render → servicio
#   contaia → pestaña "Environment". NUNCA se suben al repositorio.
#
# Casi todo tiene valores por defecto correctos: para arrancar solo
# necesitas DECOLECTA_TOKEN (RUC real) y AUTH_SECRET. Sin credenciales
# SUNAT, la app corre en MODO SIMULADO para poder probar.
# ============================================================

# --- Núcleo (obligatorias en producción) ----------------------
# Secreto para firmar la cookie de sesión. Cadena larga y aleatoria.
AUTH_SECRET=
# Carpeta de datos persistentes. En Render con disco: /var/data
DATA_DIR=/var/data
# Navegadores headless simultáneos (cola). Regla: ~2 por cada 2 GB.
# Standard(2GB)=2 · Pro(4GB)=4 · Pro Max(16GB)=10
MAX_NAVEGADORES=10

# --- Usuario supremo (dueño de la plataforma) -----------------
# Se siembra/repara solo al arrancar. Cambia estos valores en prod.
SUPREMO_EMAIL=supremo@radartributaria.com
SUPREMO_PASSWORD=
SUPREMO_NOMBRE=Administrador supremo

# --- Consulta de RUC ------------------------------------------
# auto | decolecta | apisnet | oficial | mock
SUNAT_PROVIDER=decolecta
# Token de https://decolecta.com (panel del usuario). OBLIGATORIO para RUC real.
DECOLECTA_TOKEN=
DECOLECTA_URL=https://api.decolecta.com/v1/sunat/ruc/full
DECOLECTA_REPRESENTANTES_URL=https://api.decolecta.com/v1/sunat/ruc/representantes-legales
# Alternativa: apis.net.pe
APISNET_TOKEN=
APISNET_URL=https://api.apis.net.pe/v2/sunat/ruc
# Forzar datos simulados (útil para DEMOS masivas sin tocar SUNAT)
SUNAT_FORCE_MOCK=false

# --- Navegador remoto (opcional, Browserless) -----------------
# Si se define, buzón/F36/PDF corren remotos. OJO: SUNAT bloquea las IPs
# de Browserless (no sirve para buzón/F36). También puede guardarse desde
# el panel del supremo en vez de aquí.
BROWSER_WS_URL=

# --- Antibloqueo SUNAT: captcha (CapSolver) + proxy residencial ----
# Ambos son OPCIONALES y se activan solos cuando existen. También pueden
# guardarse desde el panel del supremo (estas variables tienen prioridad).
# CapSolver: resuelve el Cloudflare Turnstile del login SOL (si aparece).
CAPSOLVER_KEY=
# Proxy residencial (evita el bloqueo por IP del servidor). Ej. Webshare/IPRoyal.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# --- Correo (recuperación de contraseña, opcional) ------------
RESEND_API_KEY=
EMAIL_FROM=Radar Tributar IA <no-reply@radartributaria.com>
# Base para los enlaces de los correos
APP_URL=https://radartributaria.com

# --- Alertas al celular (Telegram, sin verificación de Meta) ----
# Crea el bot con @BotFather en Telegram y pega aquí su token y su usuario.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=RadarTributarIA_bot
# Vigilancia del buzón: llave para cifrar la Clave SOL guardada (opt-in).
# Si falta, se deriva de AUTH_SECRET. Cambiarla invalida las claves guardadas.
VIGILANCIA_KEY=
# Tarea nocturna: hora de Lima a partir de la cual corre (default 3). Un cron
# externo también puede llamar a POST /api/tareas/nocturna?token=CRON_SECRET
CRON_SECRET=
NOCTURNA_HORA=3

# --- Integración oficial SUNAT (consulta contribuyente) -------
SUNAT_CLIENT_ID=
SUNAT_CLIENT_SECRET=
SUNAT_RUC=
SUNAT_SOL_USER=
SUNAT_SOL_PASS=
SUNAT_TOKEN_URL=https://api-seguridad.sunat.gob.pe/v1/clientessol
SUNAT_API_BASE=https://api.sunat.gob.pe/v1/contribuyente/contribuyentes

# --- SIRE: Compras y Ventas (RVIE / RCE) ----------------------
# La Clave SOL de cada cliente se ingresa por consulta y NO se guarda.
# El client_id/secret suele ir por cliente; aquí solo si usas uno común.
SUNAT_SIRE_CLIENT_ID=
SUNAT_SIRE_CLIENT_SECRET=
SIRE_SCOPE=https://api-sire.sunat.gob.pe
SIRE_API_BASE=https://api-sire.sunat.gob.pe/v1/contribuyente/migeigv/libros
SIRE_EXPORT_VENTAS_PATH=/rvierce/resumen/web/resumencomprobantes/{periodo}/{codTipoResumen}/{codTipoArchivo}/exporta?codLibro={codLibro}
SIRE_EXPORT_COMPRAS_PATH=/rvierce/resumen/web/resumencomprobantes/{periodo}/{codTipoResumen}/{codTipoArchivo}/exporta?codLibro={codLibro}
SIRE_ESTADO_PATH=/rvierce/gestionprocesosmasivos/web/masivo/consultaestadotickets?perIni={periodo}&perFin={periodo}&page=1&perPage=20&numTicket={ticket}
SIRE_DESCARGA_PATH=/rvierce/gestionprocesosmasivos/web/masivo/archivoreporte?nomArchivoReporte={nombre}&perTributario={periodo}&codLibro={codLibro}&codTipoArchivoReporte=00
SIRE_OMISOS_PATH=/rvierce/padron/web/omisos/{codLibro}/periodos
SIRE_COD_LIBRO_VENTAS=140000
SIRE_COD_LIBRO_COMPRAS=080000
SIRE_COD_TIPO_RESUMEN=2
SIRE_COD_TIPO_ARCHIVO=0
SIRE_FORCE_MOCK=false

# --- Buzón electrónico (endpoints internos del portal SOL) ----
# Tienen valores por defecto en el código; solo se sobreescriben para calibrar.
BUZON_LOGIN_URL=
BUZON_VISOR_URL=
BUZON_LIST_URL=
BUZON_BAJAR_URL=
BUZON_ARCHIVOS_URL=
BUZON_DETALLE_URL=

# ---- Pagos de planes (pasarela) ----
# PASARELA = culqi | mercadopago | izipay  (vacío = sin pago en línea; los
# botones de los planes piden el plan por WhatsApp como antes).
PASARELA=izipay
# URL pública de la web (retornos y webhooks de la pasarela).
APP_URL=https://www.radartributaria.com
# Personas con precio de lanzamiento (−50 %). Quien lo obtuvo lo conserva al renovar.
LANZAMIENTO_CUPOS=100
# Culqi (panel Culqi → Desarrollo → API Keys): pk_live_… y sk_live_…
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
# Mercado Pago (Tus integraciones → Credenciales de producción): Access Token.
# Webhook: https://www.radartributaria.com/api/webhooks/pagos/mercadopago (evento Pagos)
MP_ACCESS_TOKEN=
# Izipay (pasarela elegida). Back Office de Izipay → Configuración → Tienda →
# pestaña "Claves de API REST". Primero las de TEST (testpassword_…, testpublickey_…)
# y, cuando el pago de prueba funcione, las de PRODUCCIÓN:
#   IZIPAY_SHOP_ID    = Usuario (identificador de la tienda, solo números)
#   IZIPAY_PASSWORD   = Contraseña (test o producción)
#   IZIPAY_PUBLIC_KEY = Clave pública JavaScript (formato 12345678:publickey_…)
#   IZIPAY_HMAC_KEY   = Clave HMAC-SHA-256
# La URL del IPN se envía en cada pago; igual regístrala en Configuración →
# Reglas de notificación → "URL de notificación al final del pago":
#   https://www.radartributaria.com/api/webhooks/pagos/izipay
IZIPAY_SHOP_ID=
IZIPAY_PASSWORD=
IZIPAY_PUBLIC_KEY=
IZIPAY_HMAC_KEY=
# ---- Cupos por plan (0 = sin límite) ----
# Generaciones por paso y por empresa al mes.
CUPO_BASICO=3
CUPO_REGULAR=5
CUPO_PREMIUM=0
CUPO_EMPRESAS=0
# Comprobantes de la Descarga masiva al mes (facturas + recibos por honorarios).
TOPE_COMPROBANTES_PREMIUM=500
TOPE_COMPROBANTES_EMPRESAS=0
# Pausa mínima (minutos) entre consultas exitosas del buzón / estado SIRE de una empresa.
BUZON_PAUSA_MIN=60
SIRE_ESTADO_PAUSA_MIN=60
# ---- Seguridad ----
# Clave propia para cifrar las Claves SOL de la vigilancia (64 caracteres al azar).
VIGILANCIA_KEY=
# Correos (además del supremo) que pueden ver el dashboard ISSOSOMA, separados por coma.
ISSOSOMA_EMAILS=
# Navegadores headless simultáneos (consultas a SUNAT).
MAX_NAVEGADORES=4
# Código de acceso por correo para la cuenta supremo (además de la contraseña).
# Antes de activarlo, confirma que RECIBES correo en SUPREMO_EMAIL y que
# RESEND_API_KEY funciona: sin correo no podrías entrar. Para desactivarlo en una
# emergencia, borra esta línea y despliega.
SUPREMO_2FA=1
