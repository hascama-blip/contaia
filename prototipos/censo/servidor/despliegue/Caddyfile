# Caddy: HTTPS automático (Let's Encrypt) y proxy al portal en el puerto 3000.
# Cambia el dominio por el tuyo (el de GoDaddy). "www" redirige al principal.
{
	email directiva@TU-DOMINIO.com
}

TU-DOMINIO.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}

# Quien entre por la IP o por http va al dominio con HTTPS (Caddy sigue atendiendo
# aquí el reto de Let's Encrypt para renovar el certificado).
:80 {
	redir https://TU-DOMINIO.com{uri} permanent
}

www.TU-DOMINIO.com {
	redir https://TU-DOMINIO.com{uri} permanent
}
