# Copiar a /etc/censo.env (chmod 600). Nunca subir al repositorio.
# Firma de las cookies de sesión: una cadena larga al azar (ej. openssl rand -hex 32).
CENSO_SECRETO=CAMBIAR-POR-UNA-CADENA-LARGA-AL-AZAR
# Consulta de DNI (apidni.com). Vacío = datos simulados.
APIDNI_TOKEN=
APIDNI_URL=https://apidni.com/api/v2/dni
RENIEC_CACHE_DIAS=365
