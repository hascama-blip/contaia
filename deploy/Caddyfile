# HTTPS automático + proxy a la app. Variables desde docker-compose:
#   DOMINIO (www), DOMINIO_APEX (sin www → redirige al www), CORREO_TLS (avisos de Let's Encrypt).
{
	email {$CORREO_TLS}
}

{$DOMINIO} {
	encode zstd gzip
	# Archivos estáticos de Next con caché larga (van con hash en el nombre).
	@estaticos path /_next/static/* /favicon.ico /logo-sunat.png
	header @estaticos Cache-Control "public, max-age=31536000, immutable"
	# Las extracciones SUNAT pueden tardar varios minutos.
	reverse_proxy web:3000 {
		transport http {
			read_timeout 900s
			write_timeout 900s
		}
	}
}

{$DOMINIO_APEX} {
	redir https://{$DOMINIO}{uri} permanent
}

# Dominio de la web VIEJA (app.radartributaria.com): cuando su DNS apunte a este
# servidor, redirige a la web nueva para que los enlaces antiguos sigan sirviendo.
{$DOMINIO_VIEJO} {
	redir https://{$DOMINIO}{uri} permanent
}
