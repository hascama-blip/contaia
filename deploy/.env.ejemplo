# Copia este archivo a /opt/radar/.env y completa los valores (los mismos que
# tienes hoy en Railway → Variables). Sin comillas.

# --- Obligatorias ---
AUTH_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
DECOLECTA_TOKEN=
APP_URL=https://www.radartributaria.com
SUPREMO_EMAIL=supremo@radartributaria.com
SUPREMO_PASSWORD=
SUPREMO_NOMBRE=Administrador

# --- Correo (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Radar Tributar IA <no-reply@radartributaria.com>

# --- Alertas al celular (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=RadarTributarIA_bot
VIGILANCIA_KEY=otro-texto-largo-y-aleatorio-distinto-de-AUTH_SECRET
CRON_SECRET=
NOCTURNA_HORA=3

# --- SUNAT / navegadores ---
# Lightsail 8 GB → 5 ; 4 GB → 2 ; 2 GB → 1
MAX_NAVEGADORES=5
CAPSOLVER_KEY=
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# --- RTT (webhook de correo) ---
RTT_DOMINIO=r.radartributaria.com
RTT_WEBHOOK_SECRET=

# --- ISSOSOMA (Drive, cuenta de servicio) ---
GOOGLE_SERVICE_ACCOUNT_JSON=
ISSOSOMA_DRIVE_FOLDER_ID=
ISSOSOMA_VENTAS_FOLDER_ID=

# --- Respaldo diario a S3 (opcional; lo usa deploy/respaldo-s3.sh) ---
S3_BUCKET=
AWS_DEFAULT_REGION=sa-east-1
